# Sayt manzili (SEO, sitemap, canonical uchun)
NEXT_PUBLIC_SITE_URL=https://globalavenue.uz

# Telegram bildirishnoma (yangi ariza kelganda sotuv bo'limiga)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# CRM webhook (Bitrix24 / amoCRM inbound webhook URL)
CRM_WEBHOOK_URL=

# Analitika
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_YM_ID=

# Admin panel bazasi (SQLite, fayl asosida)
DATABASE_URL=file:../data/admin.db

# Admin paroli — bcrypt hash (parolning o'zi emas!). Generatsiya:
# node -e "require('bcryptjs').hash(process.argv[1],10).then(h=>console.log(h))" 'PAROL'
# MUHIM: bcrypt hash tarkibidagi har bir "$" belgisini "\$" bilan almashtiring —
# aks holda Next.js .env yuklovchisi ularni o'zgaruvchi sifatida "kengaytirib",
# hash'ni buzib qo'yadi (masalan $2b$10$... ning boshi yo'qolib qoladi).
ADMIN_PASSWORD_HASH=

# Session cookie'ni imzolash uchun tasodifiy qator. Generatsiya:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
