generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  taglineUz   String?
  taglineRu   String?
  status      String   @default("building") // building | selling | done | soon
  districtUz  String?
  districtRu  String?
  districtKey String?
  addressUz   String?
  addressRu   String?
  pricePerSqm Float?
  priceFrom   Float?
  priceTo     Float?
  handoverUz  String?
  handoverRu  String?
  handoverYear Int?
  floors      Int?
  apartments  Int?
  blocks      Int?
  roomOptions String   @default("[]") // JSON int[]
  cover       String?
  gallery     String   @default("[]") // JSON string[]
  descriptionUz String?
  descriptionRu String?
  highlights    String @default("[]") // JSON {uz,ru}[]
  infrastructure String @default("[]") // JSON {name:{uz,ru},distance:{uz,ru}}[]
  schedule      String @default("[]") // JSON {label:{uz,ru},date:{uz,ru},done}[]
  passport      String @default("[]") // JSON {label:{uz,ru},value:{uz,ru}}[]
  geoLat        Float?
  geoLng        Float?
  featured      Boolean @default(false)
  delivery      String? // legacy admin free-text delivery note
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units        Unit[]
  leads        Lead[]
  media        Media[]
  testimonials Testimonial[]
  progress     ProgressUpdate[]
}

model Unit {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName String?
  block       String?
  floor       Int?
  rooms       Int?
  area        Float?
  price       Float?
  status      String   @default("bosh") // bosh | band | sotilgan
  image       String?  // planirovka rasm/svg yo'li
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
}

model Lead {
  id           String   @id @default(cuid())
  name         String
  phone        String?
  projectId    String?
  project      Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName  String?
  status       String   @default("yangi")
  assignedTo   String?
  staff        Staff?   @relation(fields: [assignedTo], references: [id], onDelete: SetNull)
  nextFollowUp String?
  source       String?
  interest     String?
  comment      String?
  activity     String   @default("[]")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([assignedTo])
}

model Post {
  id          String    @id @default(cuid())
  slug        String    @unique
  category    String    @default("news") // news | guide | mortgage
  titleUz     String?
  titleRu     String?
  excerptUz   String?
  excerptRu   String?
  bodyUz      String    @default("[]") // JSON string[] (paragraphs)
  bodyRu      String    @default("[]")
  author      String?
  status      String    @default("draft")
  coverImage  String?
  readMinutes Int?
  date        DateTime?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Media {
  id          String   @id @default(cuid())
  caption     String?
  category    String   @default("other")
  imageUrl    String
  width       Int?
  height      Int?
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String?
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model Testimonial {
  id          String   @id @default(cuid())
  clientName  String
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  projectName String?
  roleUz      String?
  roleRu      String?
  rating      Int      @default(5)
  source      String?
  youtubeUrl  String?
  hasVideo    Boolean  @default(false)
  textUz      String?
  textRu      String?
  status      String   @default("published")
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model ProgressUpdate {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectName String?
  date        DateTime
  image       String?
  titleUz     String?
  titleRu     String?
  textUz      String?
  textRu      String?
  percent     Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([projectId])
}

model TeamMember {
  id        String   @id @default(cuid())
  name      String
  roleUz    String?
  roleRu    String?
  initials  String?
  order     Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vacancy {
  id           String   @id @default(cuid())
  titleUz      String?
  titleRu      String?
  locationUz   String?
  locationRu   String?
  typeUz       String?
  typeRu       String?
  requirements String   @default("[]") // JSON {uz,ru}[]
  order        Int      @default(0)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Staff {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  role      String   @default("sotuv")
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leads Lead[]
}

model Settings {
  id          Int    @id @default(1)
  companyName String @default("Global Avenue")
  phone       String @default("")
  address     String @default("")
  instagram   String @default("")
  telegram    String @default("")
  hours       String @default("")
}
